{
  "name": "rendering",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "test:scene-browser": "playwright test --config src/scene/playwright.config.ts",
    "test:layout-browser": "playwright test --config src/layout/playwright.config.ts",
    "test:board-browser": "playwright test --config src/board/playwright.config.ts",
    "test:editor-browser": "playwright test --config src/editor/playwright.config.ts",
    "test:stream-browser": "playwright test --config src/stream/playwright.config.ts",
    "test:session-browser": "playwright test --config src/session/playwright.config.ts",
    "test:ui-browser": "playwright test --config src/ui/playwright.config.ts",
    "test:performance": "playwright test --config tests/performance/playwright.config.ts",
    "test:cross-browser": "playwright test --config tests/cross-browser/playwright.config.ts",
    "test:browser-all": "npm run test:e2e && npm run test:scene-browser && npm run test:layout-browser && npm run test:board-browser && npm run test:editor-browser && npm run test:stream-browser && npm run test:session-browser && npm run test:ui-browser && npm run test:cross-browser",
    "test:backend-e2e": "playwright test --config tests/backend-e2e/playwright.config.ts",
    "test:backend-contracts": "node tests/backend-e2e/contracts-runner.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "konva": "^10.9.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "description": "Browser-first Live Whiteboard with mock generation and manual editing",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.17.1 <23",
    "npm": ">=10 <11"
  }
}
